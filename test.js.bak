
const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

try {
	process.chdir('./client');
	execSync('npm install', {stdio:'inherit'});
	execSync('npm run build', {stdio:'inherit'});
	
	console.log('✅ React приложение собрано!');
	
	const buildPath = path.join(__dirname, "client", "build");
	const targetPath = path.join(__dirname, "public", "react");
	
	if(fs.existsSync(targetPath)) {
		fs.rmSync(targetPath , {recursive:true , force:true})
	}
	
	fs.cpSync(buildPath, targetPath , {recursive:true});
	
	console.log(`📦 Файлы скопированы в ${targetPath}`);
	
} catch (e) {
	
	console.log('❌ Ошибка сборки:', error);
	process.exit(1);
}